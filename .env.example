# Copy to .env.local and fill in what you need. Everything is optional:
# with nothing set, the site runs on an in-memory store seeded with the
# timetable.

# Postgres. When set, data is stored here instead of in memory.
# DATABASE_URL=postgresql://user:password@host:5432/virtue
# Direct (non-pooled) URL for migrations, if DATABASE_URL goes through a pooler.
# DIRECT_URL=

# Who gets admin rights when they sign up (comma-separated).
# ADMIN_EMAIL_DOMAINS=virtuemovement.co.uk
# ADMIN_EMAILS=
